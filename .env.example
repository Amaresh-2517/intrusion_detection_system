# Copy these settings into your shell environment before starting the dashboard.
# This file is documentation only; the application does not load .env files.

export NIDS_DASHBOARD_USERNAME="nids-admin"
# Generate with: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('choose-a-long-password'))"
export NIDS_DASHBOARD_PASSWORD_HASH="paste-the-generated-hash-here"
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
export NIDS_FLASK_SECRET_KEY="paste-a-random-secret-here"

# Keep false for local HTTP. Set true only when HTTPS terminates at the dashboard.
export NIDS_SESSION_COOKIE_SECURE="false"
export NIDS_DASHBOARD_DEBUG="false"
